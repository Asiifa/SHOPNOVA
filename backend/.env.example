# SHOPNOVA backend configuration — placeholders only.
# Copy this file to .env locally. Never commit .env.
# Never paste real credentials into chat.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=SHOPNOVA
APP_ENV=development
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=60/minute

# ---------------------------------------------------------------------------
# Aiven PostgreSQL (service identifier: pg-39f21b1d)
# Copy host, port, database, user and password from the Aiven console.
# ---------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=21584
POSTGRES_DB=defaultdb
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
AIVEN_CA_PATH=./certs/aiven-ca.pem

# ---------------------------------------------------------------------------
# Aiven Apache Kafka Inkless (service identifier: kafka-12572b23)
# Use SASL_SSL. SCRAM-SHA-256 is the default; switch if your service uses PLAIN.
# Kafka transactions are NOT used (unsupported on diskless/Inkless topics).
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=./certs/aiven-ca.pem
KAFKA_CLIENT_ID=shopnova-api
KAFKA_TOPIC_PREFIX=shopnova.
KAFKA_AUTO_CREATE_TOPICS=false

# ---------------------------------------------------------------------------
# Aiven OpenSearch (service identifier: os-114c34a2)
# ---------------------------------------------------------------------------
OPENSEARCH_URL=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CA_CERTS=./certs/aiven-ca.pem
OPENSEARCH_INDEX=shopnova-products

# ---------------------------------------------------------------------------
# Non-secret service identifiers (safe to keep)
# ---------------------------------------------------------------------------
AIVEN_PG_SERVICE=pg-39f21b1d
AIVEN_KAFKA_SERVICE=kafka-12572b23
AIVEN_OS_SERVICE=os-114c34a2

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_SECONDS=2
CONSUMER_POLL_TIMEOUT_MS=1000
SEED_DEMO_DATA=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
